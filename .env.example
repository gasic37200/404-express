# 404-express 환경변수. 이 파일을 .env로 복사해 값을 채운다. 실제 값은 커밋하지 않는다.
# 값을 비워 두면 괄호 안 기본값을 쓴다. "필수"는 비우면 기동하지 않는다.

# --- 인증 키 (JustCommit .env와 같은 값) ---
# 필수. JustCommit -> 404-express 호출 시 X-Api-Key
COURIER_API_KEY=
# 필수. 404-express -> JustCommit 웹훅 호출 시 X-Api-Key
WEBHOOK_API_KEY=
# /api/v1/admin/** 인증(X-Admin-Key). 비우면 admin API를 열지 않는다
ADMIN_API_KEY=

# --- 웹훅 ---
# 필수. JustCommit 웹훅 수신 주소. 운영 EC2: http://replant-app:8080/api/v1/webhooks/courier
WEBHOOK_URL=
# 웹훅 응답 대기 시간 ms (5000)
WEBHOOK_TIMEOUT_MS=
# 재전송 간격 초, 쉼표 구분. 개수 = 최대 재전송 횟수 (60,300,1800,7200,21600). 로컬 테스트 예: 5,5,5,5,5
WEBHOOK_RETRY_DELAYS_SEC=

# --- 서버 ---
# 포트 (3000). 운영 compose는 3000으로 고정한다
PORT=
# SQLite 파일 경로 (./data/courier.db). 운영 compose는 /data/courier.db로 고정한다
DB_PATH=

# --- 자동 진행 ---
# false면 자동 진행을 끈다 (true)
AUTO_PROGRESS=
# 각 상태에 머무는 시간 초: 수거 (180), 배송 중 (120), 배송 완료 (120)
PICKUP_DELAY_SEC=
IN_TRANSIT_DELAY_SEC=
DELIVERY_DELAY_SEC=

# --- 워커 주기 ms ---
# 자동 진행 확인 (5000), 웹훅 전송 확인 (2000)
PROGRESS_TICK_MS=
OUTBOX_TICK_MS=

# --- docker-compose.standalone.yml(Caddy 공개 HTTPS 단독 배포)에서만 쓴다. 운영 EC2(docker-compose.prod.yml)는 쓰지 않는다 ---
DOMAIN=
