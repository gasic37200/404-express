PORT=3000
DB_PATH=./data/courier.db

# 서버 -> 택배사 호출 인증 (X-Api-Key)
COURIER_API_KEY=change-me
# /api/v1/admin/** 인증 (X-Admin-Key). 비우면 admin API 비활성화
ADMIN_API_KEY=change-me-admin

# 택배사 -> 서버 웹훅
WEBHOOK_URL=https://example.com/api/v1/webhooks/courier
WEBHOOK_API_KEY=change-me-webhook
WEBHOOK_TIMEOUT_MS=5000
# 재전송 간격(초, 쉼표 구분). 개수 = 최대 재전송 횟수. 비우면 60,300,1800,7200,21600
# 로컬 테스트 예: WEBHOOK_RETRY_DELAYS_SEC=5,5,5,5,5
WEBHOOK_RETRY_DELAYS_SEC=

# 자동 진행 (초)
AUTO_PROGRESS=true
PICKUP_DELAY_SEC=180
IN_TRANSIT_DELAY_SEC=120
DELIVERY_DELAY_SEC=120

# 워커 주기 (ms)
PROGRESS_TICK_MS=5000
OUTBOX_TICK_MS=2000

# docker compose: Caddy가 HTTPS 인증서를 받을 도메인
DOMAIN=courier.example.com
